# Hashed filenames never change their contents, so a reader downloads each one once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The icons and the card image change with a release, and a day is short enough for that.
/*.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
