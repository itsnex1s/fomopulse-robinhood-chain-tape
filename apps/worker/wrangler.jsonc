{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fomopulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The built web app, served from the colo the reader is in. `/api/*` and `/ws` are the
  // Worker's, whatever happens to be sitting in the assets directory.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // An address the app does not draw is a miss and has to say so: a shell served with a 200
    // is a soft 404, which is a crawler's word for a page that lied about existing.
    "not_found_handling": "404-page",
    // The assets answer before the Worker unless a path is listed here, and the assets hold
    // one page. So every screen past the first is the Worker's, which hands back that page;
    // everything else stays the assets' to serve or to refuse. Kept equal to VIEW_PATHS in
    // apps/server/src/api/views.ts, where the reasoning lives and which a test holds this to.
    // Both spellings of each: a pattern is matched exactly, and a trailing slash is the same
    // address to everything else that reads one.
    "run_worker_first": ["/api/*", "/ws", "/traders", "/traders/", "/bags", "/bags/", "/discover", "/discover/"]
  },

  // The site itself, and the one line in this repository that names a domain: put your own
  // here, or delete the whole entry and take the workers.dev address the deploy prints. A
  // custom domain puts the Worker behind the zone, where the managed ruleset, the rate
  // limit and the bot rules live; a workers.dev address has none of them.
  "routes": [{ "pattern": "fomopulse.app", "custom_domain": true }],

  // One object holds the tape: the subscription, the SQLite and the readers watching it.
  "durable_objects": {
    "bindings": [{ "name": "TAPE", "class_name": "Tape" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tape"] }],

  // The object keeps itself awake with an alarm; this is the spare key.
  "triggers": { "crons": ["* * * * *"] },

  // What one address may make the object do in a minute, counted per colo. The cache answers
  // the reader who is behaving; this is the ceiling on the one thing the cache cannot bound,
  // a cursor whose every value is a different and entirely valid page. Kept equal to
  // cache.objectRequestsPerMinute in config/limits.json, which is where the reasoning lives
  // and which a test holds this to.
  "unsafe": {
    "bindings": [
      {
        "name": "OBJECT_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  },

  // The tape's queries are written against bun:sqlite; on this platform they run on the
  // SQLite the object carries. See src/sqlite.ts.
  "alias": { "bun:sqlite": "./src/sqlite.ts" }
}
