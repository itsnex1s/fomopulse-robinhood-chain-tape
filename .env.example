# Copy to .env — Bun loads it on start. Every line is optional.

# WebSocket RPC for live mode. Defaults to PublicNode's public socket, which needs
# no key; set this for your own endpoint (e.g. a free Alchemy app on Robinhood Chain
# looks like wss://robinhood-mainnet.g.alchemy.com/v2/<key>).
# Without any socket, `bun run ingest --poll 12` re-reads the chain instead.
RPC_WS_URL=

# HTTP RPC for catch-up, receipts, code and block headers. Defaults to the chain's public
# endpoint, which rate-limits after a few requests; wide scans fall back to a second
# public endpoint on refusal. A provider URL removes the pacing between requests.
RPC_HTTP_URL=

# SQLite file (default fomopulse.db in the working directory).
FOMOPULSE_DB=

# Port for the API, the websocket and the built web app (default 8080).
PORT=

# Only for fomo's own numbers (PnL, avatars, positions): a fomo.family session token
# (privy:token in the site's local storage). The ingester reads the leaderboard with it
# every 10 minutes; scripts/roster.ts and scripts/enrich.ts take it for one run.
# Never needed by the tape itself.
FOMO_ACCESS_TOKEN=

# The pair that renews it, read from the same browser: privy:refresh_token and privy:pat
# in local storage. With both, the session buys its next hour from Privy before the
# current one runs out and the token above is only where it starts; without them that
# token is the whole session and it expires.
FOMO_PRIVY_PAT=
FOMO_REFRESH_TOKEN=
